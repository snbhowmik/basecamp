# Basecamp v1.0.0 — Environment Configuration
# Copy to .env, fill in real values, and NEVER commit .env to git.
# All of these belong in Docker secrets in production, not a plain env file
# sitting on the VPS — this .env is for local development only.

# --- Postgres ---
POSTGRES_PASSWORD=

# --- Auth / JWT ---
# Generate with: openssl rand -base64 48
JWT_SECRET=
# The anon and service_role keys are JWTs signed with JWT_SECRET, containing
# {"role": "anon"} and {"role": "service_role"} respectively. Generate these
# with the Supabase CLI or a JWT library once JWT_SECRET is set.
ANON_KEY=
SERVICE_ROLE_KEY=

# --- Site ---
SITE_URL=https://portal.example.edu

# --- SMTP (required — GOTRUE_MAILER_AUTOCONFIRM is "false", so nobody can
# confirm a signup, including the wizard's own captain account, without a
# working SMTP relay). Any real SMTP server works, e.g. self-hosted Mailcow
# on your own domain — get SPF/DKIM/DMARC right on that domain first.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=Basecamp

# --- Garage (self-hosted object storage) ---
GARAGE_RPC_SECRET=
GARAGE_ACCESS_KEY=
GARAGE_SECRET_KEY=

# --- Realtime (Elixir/Phoenix) ---
# Generate with: openssl rand -base64 64
REALTIME_SECRET_KEY_BASE=
# Generate with: openssl rand -hex 16
REALTIME_DB_ENC_KEY=

# --- Offsite encrypted backup target (R2 or B2) ---
# This is a BACKUP destination only — never live storage. See NOTE.md.
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_BUCKET=
BACKUP_ENCRYPTION_KEY=
